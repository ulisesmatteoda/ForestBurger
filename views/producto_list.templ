package views

import (
	"fmt"
	"math"
	"net/url"
	"strconv"
	"strings"

	"forestburger/db/sqlc"
)

// ProductosPanel es la lista con su barra de filtros y el contador. Es lo que reemplaza htmx
// al tocar un chip, así los chips, el contador y la tabla cambian juntos.
templ ProductosPanel(productos []db.Producto, categoria string, nuevoID int32) {
    <section id="panel-productos">
        <div class="barra">
            <nav class="chips" aria-label="Filtrar por categoría">
                @chipFiltro("Todos", "/admin", categoria == "")
                for _, c := range categorias {
                    @chipFiltro(c.Label, "/admin?categoria="+url.QueryEscape(c.Valor), categoria == c.Valor)
                }
            </nav>
            <span class="conteo">{ conteo(len(productos), "producto", "productos") }</span>
        </div>
        @ProductoList(productos, categoria, nuevoID)
    </section>
}

// chipFiltro es un link común (anda sin JS y con F5); con htmx pide solo el panel y deja la URL
// del filtro en la barra del navegador.
templ chipFiltro(label, ruta string, activo bool) {
    <a
        class={ "chip", templ.KV("activo", activo) }
        href={ templ.URL(ruta) }
        hx-get={ ruta }
        hx-target="#panel-productos"
        hx-swap="outerHTML"
        hx-push-url="true"
        if activo {
            aria-current="true"
        }
    >{ label }</a>
}

// ProductoList renderiza la tabla con los productos. categoria es el filtro activo ("" = todos),
// y solo cambia el mensaje cuando no hay nada para mostrar. nuevoID es el producto recién creado,
// que sale resaltado (0 = ninguno).
templ ProductoList(productos []db.Producto, categoria string, nuevoID int32) {
    <section id="lista-productos" class="tabla-contenedor">
        if len(productos) == 0 && categoria != "" {
            <p class="vacio">No hay productos en esta categoría.</p>
        } else if len(productos) == 0 {
            <p class="vacio">Todavía no hay productos. Cargá el primero con + Nuevo producto.</p>
        } else {
            <table class="tabla">
                <thead>
                    <tr>
                        <th>PRODUCTO</th>
                        <th>CATEGORÍA</th>
                        <th>PRECIO</th>
                        <th>PRECIO DOBLE</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    for _, p := range productos {
                        @filaProducto(p, p.ID == nuevoID, categoria)
                    }
                </tbody>
            </table>
        }
    </section>
}

// ProductoFila renderiza una fila de la tabla en modo lectura, con los botones de editar y borrar.
// También es lo que devuelve el servidor al guardar o cancelar una edición. categoria es el filtro
// activo de la lista: el borrado lo necesita para devolver el panel con el mismo filtro.
templ ProductoFila(p db.Producto, categoria string) {
    @filaProducto(p, false, categoria)
}

// filaProducto es la fila en modo lectura; nuevo la resalta (el producto recién creado).
templ filaProducto(p db.Producto, nuevo bool, categoria string) {
    <tr class={ templ.KV("nuevo", nuevo) }>
        <td>
            <div class="producto-celda">
                @Miniatura(p.ImagenUrl.String)
                <div>
                    <div class="producto-nombre">{ p.Nombre }</div>
                    if p.Descripcion.Valid {
                        <div class="producto-desc">{ p.Descripcion.String }</div>
                    }
                </div>
            </div>
        </td>
        <td><span class="tag">{ etiquetaCategoria(p.Categoria) }</span></td>
        <td class="precio">{ formatPrecio(p.Precio) }</td>
        <td class="precio">
            if p.PrecioDoble.Valid {
                { formatPrecio(p.PrecioDoble.String) }
            } else {
                —
            }
        </td>
        <td>
            <div class="acciones">
                <button
                    class="boton-icono"
                    aria-label={ "Editar " + p.Nombre }
                    hx-get={ fmt.Sprintf("/admin/productos/%d/editar", p.ID) }
                    hx-target="closest tr"
                    hx-swap="outerHTML"
                >
                    @IconoEditar()
                </button>
                <button
                    class="boton-icono peligro"
                    aria-label={ "Borrar " + p.Nombre }
                    hx-get={ fmt.Sprintf("/admin/productos/%d/borrar?categoria=%s", p.ID, url.QueryEscape(categoria)) }
                    hx-target="#modal"
                    hx-swap="innerHTML"
                >
                    @IconoBorrar()
                </button>
            </div>
        </td>
    </tr>
}

// ProductoFilaEditar renderiza la misma fila con inputs en cada celda. "Guardar" hace PUT con
// los valores de la fila (hx-include) y "Cancelar" vuelve a pedir la fila en modo lectura.
// Si el servidor rechaza los datos, devuelve esta misma fila con f.Error y lo que se escribió.
// foto es la ruta de la foto actual ("" si no tiene): se muestra para elegir otra o quitarla, y por
// eso Guardar va como multipart.
templ ProductoFilaEditar(id int32, f FormProducto, foto string) {
    <tr class="fila-edicion">
        <td>
            if f.Error != "" {
                <p class="error" role="alert">{ f.Error }</p>
            }
            <input class="input-fila" type="text" name="nombre" value={ f.Nombre } aria-label="Nombre"/>
            <textarea class="input-fila" name="descripcion" rows="2" aria-label="Descripción">{ f.Descripcion }</textarea>
            <div class="editar-foto">
                @Miniatura(foto)
                <div class="editar-foto-campos">
                    if foto != "" {
                        @SubirFoto("Cambiar foto", true)
                    } else {
                        @SubirFoto("Elegir foto", true)
                    }
                    if foto != "" {
                        <label class="quitar-foto">
                            <input type="checkbox" name="quitar_foto" value="1"/>
                            Quitar foto
                        </label>
                    }
                </div>
            </div>
        </td>
        <td>
            <select class="input-fila" name="categoria" aria-label="Categoría">
                for _, c := range categorias {
                    <option value={ c.Valor } selected?={ f.Categoria == c.Valor }>{ c.Label }</option>
                }
                if f.Categoria != "" && !CategoriaConocida(f.Categoria) {
                    <option value={ f.Categoria } selected>{ f.Categoria }</option>
                }
            </select>
        </td>
        <td>
            <div class="campo-precio">
                <span class="prefijo" aria-hidden="true">$</span>
                <input class="input-fila" type="number" inputmode="decimal" name="precio" min="0" step="0.01" value={ f.Precio } aria-label="Precio simple"/>
            </div>
        </td>
        <td>
            <div class="campo-precio">
                <span class="prefijo" aria-hidden="true">$</span>
                <input class="input-fila" type="number" inputmode="decimal" name="precio_doble" min="0" step="0.01" value={ f.PrecioDoble } aria-label="Precio doble"/>
            </div>
        </td>
        <td>
            <div class="acciones">
                <button
                    type="button"
                    class="btn-fila btn-guardar"
                    hx-put={ fmt.Sprintf("/admin/productos/%d", id) }
                    hx-encoding="multipart/form-data"
                    hx-include="closest tr"
                    hx-target="closest tr"
                    hx-swap="outerHTML"
                >Guardar</button>
                <button
                    type="button"
                    class="btn-fila btn-cancelar"
                    hx-get={ fmt.Sprintf("/admin/productos/%d", id) }
                    hx-target="closest tr"
                    hx-swap="outerHTML"
                >Cancelar</button>
            </div>
        </td>
    </tr>
}

// CategoriaConocida indica si la categoría está entre las del formulario. Si un producto tiene una
// categoría vieja o distinta, la edición la conserva en el select en lugar de cambiarla en silencio,
// y el filtro de la lista la ignora (muestra todos).
func CategoriaConocida(c string) bool {
	for _, k := range categorias {
		if k.Valor == c {
			return true
		}
	}
	return false
}

// formatPrecio pasa "14500.00" (como lo devuelve sqlc) a "$14.500". Muestra centavos solo si hay.
func formatPrecio(s string) string {
	f, err := strconv.ParseFloat(s, 64)
	if err != nil {
		return "$" + s
	}
	entero := int64(f)
	centavos := int64(math.Round((f - float64(entero)) * 100))
	txt := strconv.FormatInt(entero, 10)
	var b strings.Builder
	for i, c := range txt {
		if i > 0 && (len(txt)-i)%3 == 0 {
			b.WriteByte('.')
		}
		b.WriteRune(c)
	}
	if centavos > 0 {
		return fmt.Sprintf("$%s,%02d", b.String(), centavos)
	}
	return "$" + b.String()
}

// etiquetaCategoria muestra la categoría con mayúscula inicial ("hamburguesa" → "Hamburguesa").
func etiquetaCategoria(c string) string {
	if c == "" {
		return c
	}
	return strings.ToUpper(c[:1]) + c[1:]
}
