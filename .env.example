POSTGRES_DB=forestburger
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
# Mails del personal que puede ser admin, separados por coma (ej: ana@mail.com,luis@mail.com).
# make crear-admin rechaza cualquier otro, y el login también lo va a usar.
ADMIN_EMAILS=admin@forestburger.com

# Clave para firmar la cookie de sesión del panel. Obligatoria, de al menos 32 caracteres.
# Generala con: openssl rand -hex 32   (cambiarla cierra la sesión de todos los admins)
SESSION_SECRET=
# "true" en producción (HTTPS): la cookie solo viaja cifrada. En localhost, false.
COOKIE_SECURE=false

# SOLO PARA DESARROLLO. Nunca en producción. Si están las dos, al arrancar la app crea (o
# actualiza) este admin, porque make run arranca con la base vacía. El mail tiene que estar en
# ADMIN_EMAILS y la contraseña tener al menos 8 caracteres.
# DEV_ADMIN_EMAIL=admin@forestburger.com
# DEV_ADMIN_PASSWORD=una-clave-solo-local

# SOLO PARA DESARROLLO. Con 1, al arrancar con la base sin productos carga datos de prueba:
# productos, extras, ajustes y pedidos de los últimos 10 días (para ver el panel de pedidos).
# Se carga una sola vez; para empezar de cero, make clean. Nunca en producción.
# DEV_DATOS_PRUEBA=1

# ---------- Deploy (Railway). En local no hace falta nada de esto. ----------

# Puerto donde escucha la app. Railway lo pone solo; en local, 8080.
# PORT=8080

# "staging": franja "AMBIENTE DE PRUEBA" arriba de todo y noindex para los buscadores.
# Vacío en local y en producción.
# AMBIENTE=staging

# Fotos en Cloudflare R2 (compatible S3). O todas o ninguna: sin ninguna, las fotos van a
# uploads/ como en local; con algunas, la app no arranca y dice cuál falta.
# Endpoint S3 de la cuenta (R2 → Manage API tokens): https://<account_id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# Nombre del bucket.
# S3_BUCKET=
# Access key y secret del token de API de R2 (permiso "Object Read & Write" sobre el bucket).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# URL pública del bucket (r2.dev o dominio propio), sin la barra final: https://pub-xxxx.r2.dev
# FOTOS_URL_PUBLICA=
